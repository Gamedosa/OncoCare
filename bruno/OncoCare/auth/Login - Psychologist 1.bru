meta {
  name: Login - Psychologist 1
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{psychologist1Email}}",
    "password": "{{psychologist1Password}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.access_token) {
    bru.setEnvVar('psychologist1AccessToken', res.body.access_token);
  }
}

tests {
  test("psychologist 1 login succeeds", function() {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}